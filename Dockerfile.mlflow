FROM python:3.13-slim

WORKDIR /app

COPY requirements.txt .

RUN pip install --no-cache-dir -r requirements.txt

EXPOSE 5000

CMD ["mlflow", "server", "--host", "0.0.0.0", "--port", "5000", "--backend-store-uri", "sqlite:////app/mlflow_data/mlflow.db", "--artifacts-destination", "/app/mlartifacts",  "--allowed-hosts", "mlflow:5000,localhost:5000,127.0.0.1:5000"]